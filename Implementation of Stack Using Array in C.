#include <stdio.h>
#include <stdlib.h>
 
#define MAX 100  // Maximum size of stack
 
int stack[MAX];  // Array to store stack elements
int top = -1;   // Variable to keep track of the top element index (-1 means stack is empty)
 
// Function to push element onto stack
void push(int value) {
   if (top == MAX - 1) {  // Check if stack is full
       printf("Stack Overflow! Cannot push %d\n", value);
   } else {
       top++;               // Increment top index
       stack[top] = value;  // Insert the value at top
       printf("Pushed %d to stack.\n", value);
   }
}
 
// Function to pop element from stack
void pop() {
   if (top == -1) {  // Check if stack is empty
       printf("Stack Underflow! Cannot pop.\n");
   } else {
       printf("Popped %d from stack.\n", stack[top]);
       top--;  // Decrement top index
   }
}
 
// Function to return the top element without removing it
void peek() {
   if (top == -1) {  // Check if stack is empty
       printf("Stack is Empty.\n");
   } else {
       printf("Top element is %d\n", stack[top]);
   }
}
 
// Function to display all stack elements
void display() {
   int i;
   if (top == -1) {  // Check if stack is empty
       printf("Stack is Empty.\n");
   } else {
       printf("Stack elements (top to bottom):\n");
       for (i = top; i >= 0; i--) {  // Print from top to bottom
           printf("%d\n", stack[i]);
       }
   }
}
 
// Main function with menu-driven program
int main() {
   int choice, value;
 
   while (1) {  // Infinite loop until user chooses to exit
       printf("\n--- Stack Menu ---\n");
       printf("1. Push\n2. Pop\n3. Peek\n4. Display\n5. Exit\n");
       printf("Enter your choice: ");
       scanf("%d", &choice);
 
       switch (choice) {
           case 1:
               printf("Enter value to push: ");
               scanf("%d", &value);
               push(value);  // Call push function
               break;
           case 2:
               pop();  // Call pop function
               break;
           case 3:
               peek();  // Call peek function
               break;
           case 4:
               display();  // Call display function
               break;
           case 5:
               exit(0);  // Exit the program
           default:
               printf("Invalid choice! Try again.\n");
       }
   }
 
   return 0;
}
